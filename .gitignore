# See https://git-scm.com/docs/gitignore for pattern syntax.

# dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage/
/.vitest/

# next.js
/.next/
/out/
/.next-profiles/
next-panic-*.log

# production
/build/

# local editor and operating-system files
/.idea/
/.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# local certificates
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files may contain secrets; commit only a value-free template
.env*
!.env.example

# vercel
/.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts
